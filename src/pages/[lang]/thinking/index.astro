---
import { getCollection } from "astro:content";
import FormattedDate from "@/components/FormattedDate.astro";
import PageLayout from "@/layouts/Base.astro";

export function getStaticPaths() {
	return [{ params: { lang: "zh" } }, { params: { lang: "en" } }];
}

const { lang } = Astro.params;
const isZh = lang === "zh";
const title = isZh ? "随想" : "Thinking";

const allThoughts = await getCollection(
	"thinking",
	(post) => post.data.lang === lang && !post.data.draft,
);
allThoughts.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---

<PageLayout meta={{ title }}>
	<section>
		<h1 class="title mb-6">{title}</h1>
		<ul class="space-y-4">
			{allThoughts.map((post) => (
				<li>
					<FormattedDate date={post.data.date} />
					<a
						class="cactus-link ml-4 block"
						href={`/${lang}/thinking/${post.id.split("/").pop()}/`}
					>
						{post.data.title}
					</a>
				</li>
			))}
		</ul>
	</section>
</PageLayout>
